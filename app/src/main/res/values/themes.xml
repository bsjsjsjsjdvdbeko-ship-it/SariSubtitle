<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SariSubtitle.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sari_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_sari_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.SariSubtitle</item>
    </style>

    <style name="Theme.SariSubtitle" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sari_primary</item>
        <item name="colorOnPrimary">@color/sari_on_primary</item>
        <item name="colorSecondary">@color/sari_primary</item>
        <item name="colorSurface">@color/sari_surface</item>
        <item name="android:windowBackground">@color/sari_background</item>
        <item name="android:statusBarColor">@color/sari_surface</item>
        <item name="android:navigationBarColor">@color/sari_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/sari_primary</item>
    </style>

    <style name="Widget.SariSubtitle.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/sari_primary_dark</item>
        <item name="android:textColor">@color/sari_on_primary</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.SariSubtitle.SecondaryButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/sari_surface_variant</item>
        <item name="android:textColor">@color/sari_text</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.SariSubtitle.NavButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/sari_surface_variant</item>
        <item name="android:textColor">@color/sari_text</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
    </style>

    <style name="Widget.SariSubtitle.IconButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/sari_surface_variant</item>
        <item name="android:textColor">@color/sari_text</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
