<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sari Subtitle"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ترجمتك العربية بسهولة — اختر المهمة التي تريدها"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/bsOneTapArabicButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⚡ ترجمة الفيديو إلى العربية" />

        <Button
            android:id="@+id/bsGenerateSrtButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="🎬 إنشاء ملف ترجمة SRT من رابط" />

        <Button
            android:id="@+id/bsImportSrtButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="📂 فتح ملف ترجمة SRT" />

        <Button
            android:id="@+id/bsTranslateSrtButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="🌐 ترجمة ملف SRT" />

        <Button
            android:id="@+id/bsSavedItemsButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="📁 ملفاتي المحفوظة" />

        <Button
            android:id="@+id/toggleAdvancedToolsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="⚙ أدوات متقدمة وإعدادات المزامنة  ▾" />

        <LinearLayout
            android:id="@+id/advancedToolsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="أدوات استخراج الصوت والترجمة"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="?android:attr/textColorPrimary"
                android:padding="6dp" />

            <Button android:id="@+id/bsTranscribeXButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🎙️ تفريغ فيديو من X" />
            <Button android:id="@+id/bsTranscribeAudioButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🎙️ تفريغ ملف صوت أو MP3" />
            <Button android:id="@+id/bsDirectMediaButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔗 تفريغ رابط صوت أو فيديو مباشر" />
            <Button android:id="@+id/bsAnalyzeLinkButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔍 تحليل الرابط الحالي" />
            <Button android:id="@+id/bsPasteSubWhisperButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🌐 تفريغ الرابط عبر SubWhisper" />
            <Button android:id="@+id/bsOpenDownloaderButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⬇️ فتح أداة تنزيل فيديو X" />
            <Button android:id="@+id/bsOpenChromeDownloaderButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📥 تنزيل صوت من رابط فيديو" />
            <Button android:id="@+id/bsCopyLinkButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📋 نسخ الرابط الحالي" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?android:attr/listDivider" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ضبط مزامنة الترجمة" android:textSize="15sp" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary" android:padding="6dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/bsOffsetMinus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="− 0.5 ث" />
                <Button android:id="@+id/bsOffsetPlus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+ 0.5 ث" />
                <Button android:id="@+id/bsOffsetReset" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="تصفير" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
