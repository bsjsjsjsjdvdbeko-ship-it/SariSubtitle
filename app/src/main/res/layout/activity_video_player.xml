<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/playerBack" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/background" app:title="@string/player_title"
        app:titleTextColor="@color/text_primary" app:navigationIcon="@drawable/ic_arrow_back" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp"
        android:text="@string/player_url_hint" android:textColor="@color/text_secondary" android:textSize="13sp" />
    <EditText android:id="@+id/videoUrlInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="12dp" android:singleLine="true" android:inputType="textUri"
        android:hint="https://example.com/video.mp4" android:padding="12dp"
        android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
        android:backgroundTint="@color/outline" />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginTop="6dp"
        app:boxBackgroundMode="outline">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/subtitleUrlInput"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true"
            android:inputType="textUri" android:hint="@string/player_subtitle_url"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_marginTop="6dp"
        app:boxBackgroundMode="outline">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/drmLicenseUrlInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:inputType="textUri"
            android:hint="@string/player_drm_license_url" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/playUrlButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp"
        android:text="@string/player_play_url" app:icon="@drawable/ic_play" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="12dp" android:layout_marginBottom="8dp">
        <androidx.media3.ui.PlayerView android:id="@+id/videoPlayerView"
            android:layout_width="match_parent" android:layout_height="match_parent"
            app:use_controller="true" app:show_buffering="when_playing" />
        <TextView android:id="@+id/liveSubtitleText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
            android:layout_marginBottom="26dp" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="4dp" android:paddingBottom="4dp" android:gravity="center"
            android:textAlignment="center" android:textDirection="anyRtl"
            android:textColor="@android:color/white" android:textSize="24sp" android:textStyle="bold"
            android:maxLines="2" android:ellipsize="end" android:shadowColor="#CC000000"
            android:shadowDx="0" android:shadowDy="2" android:shadowRadius="5"
            android:background="@android:color/transparent" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/loadSubtitleButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/player_load_subtitle"/>
        <Space android:layout_width="8dp" android:layout_height="1dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/openSourceButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/player_open_source"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/startPlayerTranslationButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp"
        android:text="@string/player_start_translation" app:icon="@drawable/ic_translate" />
    <TextView android:id="@+id/videoPlayerStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp" android:gravity="center" android:text="@string/player_idle"
        android:textColor="@color/text_secondary" android:textSize="13sp" />
</LinearLayout>
