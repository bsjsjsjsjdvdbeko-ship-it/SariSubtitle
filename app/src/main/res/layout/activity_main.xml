<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <!-- WebView كامل (95% من الشاشة) -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomBar"
        android:layout_below="@+id/topBar" />

    <!-- SubtitleOverlay فوق WebView -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomBar"
        android:layout_below="@+id/topBar">

        <com.sari.subtitle.SubtitleOverlay
            android:id="@+id/subtitleOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- الشريط العلوي (رفيع) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#1A1A1A">

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="الصق رابط الفيديو هنا…"
            android:inputType="textUri"
            android:singleLine="true"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:textColorHint="#B0B0B0" />

        <Button
            android:id="@+id/loadButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:text="فتح" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="⚙️" />

    </LinearLayout>

    <!-- شريط الحالة (شفاف) -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottomBar"
        android:padding="6dp"
        android:fontFamily="sans"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:maxLines="3"
        android:background="#CC202020"
        android:visibility="gone"
        android:text="@string/status_ready" />

    <!-- Stage 26: live operation status and one-tap full history -->
    <LinearLayout
        android:id="@+id/operationLogPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/topBar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="#D91A1A1A">
        <TextView
            android:id="@+id/operationLogText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="سجل العمليات: جاهز"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:maxLines="2" />
        <Button
            android:id="@+id/operationLogButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:textSize="10sp"
            android:text="السجل" />
    </LinearLayout>

    <!-- شريط المهام الرئيسي: بدء تلقائي، اختيار ملف ذكي، ومكتبة محفوظات -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="24dp"
        android:background="#1A1A1A">

        <Button
            android:id="@+id/menuButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:minHeight="54dp"
            android:layout_marginEnd="4dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="ابدأ الترجمة"
            android:contentDescription="ابدأ ترجمة الفيديو تلقائيًا بالعربية من الرابط الحالي أو المنسوخ" />

        <Button
            android:id="@+id/loadSrtButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.88"
            android:minHeight="54dp"
            android:layout_marginHorizontal="3dp"
            android:textSize="12sp"
            android:text="ملف ترجمة"
            android:contentDescription="اختر ملف ترجمة؛ يكتشف التطبيق اللغة ويترجمه إلى العربية أو يعرضه إذا كان عربيًا" />

        <Button
            android:id="@+id/dubbingButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.72"
            android:minHeight="54dp"
            android:layout_marginHorizontal="2dp"
            android:textSize="10sp"
            android:text="دبلجة"
            android:contentDescription="تشغيل أو إيقاف الدبلجة العربية؛ اضغط مطولاً لإظهار أو إخفاء الترجمة المكتوبة" />

        <Button
            android:id="@+id/dubbingExportButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.88"
            android:minHeight="54dp"
            android:layout_marginHorizontal="2dp"
            android:textSize="9sp"
            android:text="تصدير الدبلجة"
            android:contentDescription="توليد وحفظ ملف WAV للدبلجة العربية مع الحفاظ على توقيتات SRT" />

        <Button
            android:id="@+id/savedItemsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.70"
            android:minHeight="54dp"
            android:layout_marginStart="4dp"
            android:textSize="12sp"
            android:text="ملفاتي"
            android:contentDescription="افتح ملفات الترجمة المحفوظة أو احذفها" />

    </LinearLayout>

    <!-- أزرار مخفية للاستخدام القديم (مخفية) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <Button android:id="@+id/toggleOverlayButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/transcribeXAutoButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/testCaptureButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/transcribeAudioButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/transcribeDirectMediaUrlButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/importSrtFromUrlButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/analyzeLinkButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/generateSrtFromLinkButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/pasteLinkTranscribeButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/copyLinkOnlyButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/translateSrtButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/offsetMinusButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/offsetPlusButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/offsetResetButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/checkTimeButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/reloadXButton" android:layout_width="1dp" android:layout_height="1dp" />

    </LinearLayout>

</RelativeLayout>
