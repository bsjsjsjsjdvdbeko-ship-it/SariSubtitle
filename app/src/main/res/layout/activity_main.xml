<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sari_background"
    android:fitsSystemWindows="true">

    <!-- Embedded video/web player; kept in place to preserve existing playback and subtitle sync. -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/topBar"
        android:background="@color/sari_background" />

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/topBar">
        <com.sari.subtitle.v2.SubtitleOverlay
            android:id="@+id/subtitleOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Friendly first-run home state; hidden automatically when a page starts loading. -->
        <LinearLayout
            android:id="@+id/welcomePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@color/sari_background">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/sari_surface"
                app:cardCornerRadius="28dp"
                app:strokeColor="@color/sari_outline"
                app:strokeWidth="1dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <TextView
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/bg_sari_logo"
                        android:gravity="center"
                        android:text="S▶"
                        android:textColor="@color/sari_on_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="شاهد وافهم بلغتك"
                        android:textColor="@color/sari_text"
                        android:textSize="23sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="ترجمة متزامنة، ودبلجة عربية، ومكتبة تحفظ ما شاهدته — في مكان واحد."
                        android:textColor="@color/sari_muted"
                        android:textSize="14sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/welcomeStartButton"
                        style="@style/Widget.SariSubtitle.PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="22dp"
                        android:text="ابدأ الترجمة  ▶"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="الصق رابط الفيديو أعلاه، أو اختر ملف SRT من الأسفل"
                        android:textColor="@color/sari_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </FrameLayout>

    <!-- Material-inspired top app bar with rounded URL/search field. -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:background="@color/sari_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="S"
                android:textStyle="bold"
                android:textSize="23sp"
                android:textColor="@color/sari_on_primary"
                android:background="@drawable/bg_sari_logo" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sari Subtitle"
                    android:textColor="@color/sari_text"
                    android:textStyle="bold"
                    android:textSize="17sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ترجمة ومشاهدة متزامنة"
                    android:textColor="@color/sari_muted"
                    android:textSize="11sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="@style/Widget.SariSubtitle.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="⚙"
                android:contentDescription="الإعدادات" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sari_search"
                android:hint="ابحث أو الصق رابط الفيديو…"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/sari_text"
                android:textColorHint="@color/sari_muted"
                android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/loadButton"
                style="@style/Widget.SariSubtitle.SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:minWidth="58dp"
                android:text="فتح" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/openExternalButton"
                style="@style/Widget.SariSubtitle.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:text="↗"
                android:contentDescription="فتح الرابط في المتصفح الخارجي" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_margin="10dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:padding="10dp"
        android:textSize="12sp"
        android:textColor="@color/sari_text"
        android:maxLines="3"
        android:background="@drawable/bg_sari_status"
        android:elevation="5dp"
        android:visibility="gone"
        android:text="جاهز للترجمة" />

    <!-- Compact bottom navigation: actions remain wired to existing IDs and logic. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:background="@color/sari_surface"
        android:elevation="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuButton"
            style="@style/Widget.SariSubtitle.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1.35"
            android:layout_marginEnd="4dp"
            android:text="▶  ابدأ الترجمة"
            android:textSize="13sp"
            android:contentDescription="ابدأ ترجمة الفيديو تلقائيًا بالعربية من الرابط الحالي أو المنسوخ" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loadSrtButton"
            style="@style/Widget.SariSubtitle.NavButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="0.9"
            android:layout_marginHorizontal="2dp"
            android:text="字幕\nملف SRT"
            android:textSize="10sp"
            android:contentDescription="اختر ملف ترجمة؛ يكتشف التطبيق اللغة ويترجمه إلى العربية أو يعرضه إذا كان عربيًا" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dubbingButton"
            style="@style/Widget.SariSubtitle.NavButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="0.75"
            android:layout_marginHorizontal="2dp"
            android:text="🔊\nدبلجة"
            android:textSize="10sp"
            android:contentDescription="تشغيل أو إيقاف الدبلجة العربية؛ اضغط مطولاً لإظهار أو إخفاء الترجمة المكتوبة" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dubbingExportButton"
            style="@style/Widget.SariSubtitle.NavButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="0.85"
            android:layout_marginHorizontal="2dp"
            android:text="⬇\nتصدير WAV"
            android:textSize="9sp"
            android:contentDescription="توليد وحفظ ملف WAV للدبلجة العربية مع الحفاظ على توقيتات SRT" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/savedItemsButton"
            style="@style/Widget.SariSubtitle.NavButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="0.78"
            android:layout_marginStart="2dp"
            android:text="▤\nملفاتي"
            android:textSize="10sp"
            android:contentDescription="افتح ملفات الترجمة المحفوظة أو احذفها" />
    </LinearLayout>

    <!-- Legacy controls retained for existing Kotlin listeners and workflows. -->
    <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
        <Button android:id="@+id/toggleOverlayButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/transcribeXAutoButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/testCaptureButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/transcribeAudioButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/transcribeDirectMediaUrlButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/importSrtFromUrlButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/analyzeLinkButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/generateSrtFromLinkButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/pasteLinkTranscribeButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/copyLinkOnlyButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/translateSrtButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/offsetMinusButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/offsetPlusButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/offsetResetButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/checkTimeButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/reloadXButton" android:layout_width="1dp" android:layout_height="1dp" />
    </LinearLayout>
</RelativeLayout>
