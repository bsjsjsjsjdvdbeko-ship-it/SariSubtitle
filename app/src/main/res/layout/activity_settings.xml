<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:title="@string/settings_title"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_hub_description"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openKeysPageButton" android:layout_width="match_parent"
                    android:layout_height="64dp" android:gravity="start|center_vertical"
                    android:paddingStart="18dp" android:text="@string/settings_card_keys"
                    android:textSize="16sp" app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp" app:icon="@drawable/ic_key" app:iconTint="@color/primary" app:iconPadding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openSttSettingsButton" android:layout_width="match_parent"
                    android:layout_height="64dp" android:gravity="start|center_vertical"
                    android:paddingStart="18dp" android:text="@string/settings_card_stt"
                    android:textSize="16sp" app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp" app:icon="@drawable/ic_mic" app:iconTint="@color/primary" app:iconPadding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openLanguagesPageButton" android:layout_width="match_parent"
                    android:layout_height="64dp" android:gravity="start|center_vertical"
                    android:paddingStart="18dp" android:text="@string/languages"
                    android:textSize="16sp" app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp" app:icon="@drawable/ic_translate" app:iconTint="@color/primary" app:iconPadding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openAppearancePageButton" android:layout_width="match_parent"
                    android:layout_height="64dp" android:gravity="start|center_vertical"
                    android:paddingStart="18dp" android:text="@string/appearance"
                    android:textSize="16sp" app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp" app:icon="@drawable/ic_palette" app:iconTint="@color/primary" app:iconPadding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openQualityPageButton" android:layout_width="match_parent"
                    android:layout_height="64dp" android:gravity="start|center_vertical"
                    android:paddingStart="18dp" android:text="@string/settings_card_quality"
                    android:textSize="16sp" app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp" app:icon="@drawable/ic_check" app:iconTint="@color/primary" app:iconPadding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openContextPageButton" android:layout_width="match_parent"
                    android:layout_height="64dp" android:gravity="start|center_vertical"
                    android:paddingStart="18dp" android:text="@string/settings_card_context"
                    android:textSize="16sp" app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp" app:icon="@drawable/ic_translate" app:iconTint="@color/primary" app:iconPadding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openOmniRoutePageButton" android:layout_width="match_parent"
                    android:layout_height="64dp" android:gravity="start|center_vertical"
                    android:paddingStart="18dp" android:text="@string/settings_card_omniroute"
                    android:textSize="16sp" app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp" app:icon="@drawable/ic_settings" app:iconTint="@color/primary" app:iconPadding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openOrchestrationPageButton" android:layout_width="match_parent"
                    android:layout_height="64dp" android:gravity="start|center_vertical"
                    android:paddingStart="18dp" android:text="@string/settings_card_orchestration"
                    android:textSize="16sp" app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp" app:icon="@drawable/ic_settings" app:iconTint="@color/primary" app:iconPadding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openHistoryPageButton" android:layout_width="match_parent"
                    android:layout_height="64dp" android:gravity="start|center_vertical"
                    android:paddingStart="18dp" android:text="@string/history"
                    android:textSize="16sp" app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp" app:icon="@drawable/ic_history" app:iconTint="@color/primary" app:iconPadding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openAboutPageButton" android:layout_width="match_parent"
                    android:layout_height="64dp" android:gravity="start|center_vertical"
                    android:paddingStart="18dp" android:text="@string/about"
                    android:textSize="16sp" app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp" app:icon="@drawable/ic_info" app:iconTint="@color/primary" app:iconPadding="14dp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
