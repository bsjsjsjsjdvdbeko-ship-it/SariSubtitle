<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background" android:layoutDirection="locale">
 <com.google.android.material.appbar.MaterialToolbar android:id="@+id/subpageToolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/background" app:titleTextColor="@color/text_primary" app:navigationIcon="@drawable/ic_arrow_back"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
   <TextView android:id="@+id/subpageDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginBottom="14dp"/>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/providerLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundMode="outline" app:endIconMode="dropdown_menu"><com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/providerChoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:hint="مزوّد الترجمة"/></com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/positionLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundMode="outline" app:endIconMode="dropdown_menu"><com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/positionChoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:hint="موضع الترجمة"/></com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/fieldSecretLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundMode="outline" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/fieldSecret" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:singleLine="true"/></com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/translationKeyLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundMode="outline" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/translationKeyField" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:singleLine="true"/></com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/emailLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/emailField" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:singleLine="true"/></com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/fieldUrlLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/fieldUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:singleLine="true"/></com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/fieldModelLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/fieldModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true"/></com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/fieldTranslationModelLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/fieldTranslationModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true"/></com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/fieldAlternatesLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/fieldAlternates" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:minLines="2" android:gravity="top|start"/></com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/contextPromptLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/contextPromptField" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:minLines="3" android:gravity="top|start"/></com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/fieldGlossaryLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/fieldGlossary" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:minLines="3" android:gravity="top|start"/></com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.slider.Slider android:id="@+id/fontSizeSlider" android:layout_width="match_parent" android:layout_height="wrap_content" app:valueFrom="12" app:valueTo="48" app:stepSize="1"/>
   <TextView android:id="@+id/fontSizeLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:layout_marginBottom="8dp"/>
   <com.google.android.material.slider.Slider android:id="@+id/opacitySlider" android:layout_width="match_parent" android:layout_height="wrap_content" app:valueFrom="0" app:valueTo="100" app:stepSize="1"/>
   <TextView android:id="@+id/opacityLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:layout_marginBottom="8dp"/>
   <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/contextAwareSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="استخدام السياق"/>
   <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/translationMemorySwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ذاكرة الترجمة"/>
   <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/smartRoutingSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Smart Routing"/>
   <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/qualityRetrySwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quality-aware Retry"/>
   <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/compareCandidatesSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Compare Candidates"/>
   <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/streamingSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Streaming Orchestration"/>
   <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/quotaSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quota Monitoring"/>
   <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/benchmarkSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Provider Benchmark"/>
   <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/circuitBreakerSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Circuit Breaker"/>
   <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/adaptiveRoutingSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Adaptive Routing"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/subpageActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/subpageSaveButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:text="@string/save_settings" app:icon="@drawable/ic_check"/>
  </LinearLayout>
 </ScrollView>
</LinearLayout>