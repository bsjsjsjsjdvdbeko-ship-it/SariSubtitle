<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ماذا تريد أن تفعل؟"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختر المهمة فقط؛ سيكتشف التطبيق اللغة ويستخدم مزود الترجمة المتاح تلقائيًا."
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/bsOneTapArabicButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:text="▶ ابدأ من رابط الفيديو الحالي" />

        <Button
            android:id="@+id/bsTranslateSrtButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="8dp"
            android:text="🌐 ترجم ملف SRT إلى العربية" />

        <Button
            android:id="@+id/bsImportSrtButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="8dp"
            android:text="📂 افتح ملف ترجمة على الفيديو" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="المزودات الاحتياطية تعمل في الخلفية عند توفر مفاتيحها. لا حاجة لاختيارها كل مرة."
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>
</ScrollView>
