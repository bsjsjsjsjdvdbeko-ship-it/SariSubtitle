<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SariSubtitle" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/sari_background</item>
        <item name="android:colorBackground">@color/sari_surface</item>
        <item name="android:textColorPrimary">@color/sari_text_primary</item>
        <item name="android:textColorSecondary">@color/sari_text_muted</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/sari_background</item>
        <item name="android:navigationBarColor">@color/sari_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/sari_accent_bright</item>
        <item name="android:colorAccent">@color/sari_accent_bright</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
